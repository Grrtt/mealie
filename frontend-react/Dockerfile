FROM node:24-alpine AS builder

WORKDIR /app/frontend-react

ARG SUB_PATH=/
ENV SUB_PATH=${SUB_PATH}
ARG VITE_RELEASE_VARIANT=react-default
ENV VITE_RELEASE_VARIANT=${VITE_RELEASE_VARIANT}
ARG VITE_LEGACY_FALLBACK_ORIGIN=
ENV VITE_LEGACY_FALLBACK_ORIGIN=${VITE_LEGACY_FALLBACK_ORIGIN}
ARG VITE_ROUTE_SLICE_AUTH=true
ENV VITE_ROUTE_SLICE_AUTH=${VITE_ROUTE_SLICE_AUTH}
ARG VITE_ROUTE_SLICE_PUBLIC_RECIPES=true
ENV VITE_ROUTE_SLICE_PUBLIC_RECIPES=${VITE_ROUTE_SLICE_PUBLIC_RECIPES}
ARG VITE_ROUTE_SLICE_GROUP_HOME=true
ENV VITE_ROUTE_SLICE_GROUP_HOME=${VITE_ROUTE_SLICE_GROUP_HOME}
ARG VITE_ROUTE_SLICE_RECIPE_CREATE_IMPORT=true
ENV VITE_ROUTE_SLICE_RECIPE_CREATE_IMPORT=${VITE_ROUTE_SLICE_RECIPE_CREATE_IMPORT}
ARG VITE_ROUTE_SLICE_RECIPES=true
ENV VITE_ROUTE_SLICE_RECIPES=${VITE_ROUTE_SLICE_RECIPES}
ARG VITE_ROUTE_SLICE_COOKBOOKS=true
ENV VITE_ROUTE_SLICE_COOKBOOKS=${VITE_ROUTE_SLICE_COOKBOOKS}
ARG VITE_ROUTE_SLICE_HOUSEHOLD=true
ENV VITE_ROUTE_SLICE_HOUSEHOLD=${VITE_ROUTE_SLICE_HOUSEHOLD}
ARG VITE_ROUTE_SLICE_SHOPPING_LISTS=true
ENV VITE_ROUTE_SLICE_SHOPPING_LISTS=${VITE_ROUTE_SLICE_SHOPPING_LISTS}
ARG VITE_ROUTE_SLICE_USER_PROFILE=true
ENV VITE_ROUTE_SLICE_USER_PROFILE=${VITE_ROUTE_SLICE_USER_PROFILE}
ARG VITE_ROUTE_SLICE_GROUP_DATA=true
ENV VITE_ROUTE_SLICE_GROUP_DATA=${VITE_ROUTE_SLICE_GROUP_DATA}
ARG VITE_ROUTE_SLICE_ADMIN=true
ENV VITE_ROUTE_SLICE_ADMIN=${VITE_ROUTE_SLICE_ADMIN}

COPY frontend-react/package.json frontend-react/yarn.lock ./
RUN yarn install \
    --prefer-offline \
    --frozen-lockfile \
    --non-interactive \
    --production=false \
    --network-timeout 1000000

COPY frontend-react ./
COPY frontend/app/lib/api/types /app/frontend/app/lib/api/types
COPY frontend/app/lang/messages /app/frontend/app/lang/messages
COPY frontend/app/lang/dateTimeFormats /app/frontend/app/lang/dateTimeFormats
RUN yarn build

FROM nginx:1.27-alpine AS runtime

COPY --from=builder /app/frontend-react/dist /usr/share/nginx/html
COPY frontend-react/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/index.html || exit 1
