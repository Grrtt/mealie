# ── Database ──────────────────────────────────────────────────────────────────
# Engine: sqlite or postgres
DB_ENGINE=sqlite

# SQLite (development): relative path or absolute path
DATABASE_URL=Data Source=./data/mealie.db

# PostgreSQL (production): standard connection string
# DATABASE_URL=Host=localhost;Port=5432;Database=mealie;Username=mealie;Password=mealie

# ── Application ───────────────────────────────────────────────────────────────
# REQUIRED: Random secret for JWT signing. Minimum 32 characters.
SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Base URL used for link generation (password reset emails, webhooks)
BASE_URL=http://localhost:9000

# Data directory for recipe images, assets, backups
DATA_DIR=./data

# Log level: Verbose, Debug, Information, Warning, Error, Fatal
LOG_LEVEL=Information

# HTTP port
API_PORT=9000

# Allow public user registration
ALLOW_SIGNUP=true

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Leave blank to disable email features (password reset emails, invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mealie.io
SMTP_FROM_NAME=Mealie
SMTP_AUTH_STRATEGY=TLS  # NONE, SSL, TLS

# ── LDAP (optional) ───────────────────────────────────────────────────────────
LDAP_AUTH_ENABLED=false
LDAP_SERVER_URL=ldap://ldap.example.com
LDAP_TLS_INSECURE=false
LDAP_TLS_CACERTFILE=
LDAP_ENABLE_STARTTLS=false
LDAP_BASE_DN=dc=example,dc=com
LDAP_QUERY_BIND=cn=readonly,dc=example,dc=com
LDAP_QUERY_PASSWORD=
LDAP_USER_FILTER=(&(objectClass=person)(uid={input}))
LDAP_ADMIN_FILTER=
LDAP_ID_ATTRIBUTE=uid
LDAP_MAIL_ATTRIBUTE=mail
LDAP_NAME_ATTRIBUTE=cn

# ── OIDC (optional) ───────────────────────────────────────────────────────────
OIDC_AUTH_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CONFIGURATION_URL=https://provider.example.com/.well-known/openid-configuration
OIDC_AUTO_REDIRECT=false
OIDC_PROVIDER_NAME=SSO
OIDC_SIGNUP_ENABLED=true
OIDC_USER_CLAIM=email
OIDC_USER_GROUP=
OIDC_ADMIN_GROUP=
OIDC_GROUPS_CLAIM=groups

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# Enables AI-powered ingredient parsing and recipe generation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_WORKERS=2
OPENAI_SEND_DATABASE_DATA=true
