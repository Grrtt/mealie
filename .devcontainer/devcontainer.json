{
  "name": "Mealie C# + React",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "VARIANT": "1-10.0-bookworm",
      "NODE_VERSION": "22"
    }
  },
  "mounts": [
    "source=mealie-devcontainer-workspace,target=/workspaces/mealie/frontend-react/node_modules,type=volume",
    "source=mealie-bashhistory,target=/home/vscode/commandhistory,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "backend-dotnet/Mealie.slnx"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-dotnettools.csdevkit",
        "streetsidesoftware.code-spell-checker-cspell-bundled-dictionaries"
      ]
    }
  },
  "forwardPorts": [
    4173,
    9000,
    9091
  ],
  "onCreateCommand": "sudo chown -R vscode:vscode /workspaces/mealie/frontend-react/node_modules /home/vscode/commandhistory && task setup --force",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    }
  },
  "appPort": [
    "4173:4173",
    "9000:9000"
  ]
}
